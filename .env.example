# Optional public production origin, shared by canonical URL, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://entrance-exams.vercel.app
# Optional Search Console token. Leave empty until you have a real token.
GOOGLE_SITE_VERIFICATION=
# Updater only; the website does not need these. Never commit real values.
# CLI scripts read process.env; they do not automatically read this example file.
GROQ_API_KEY=
TAVILY_API_KEY=
